#!/usr/bin/env python3
"""Select the single managed Chrome profile owned by the Linux systemd lifecycle."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

REGISTRY = Path(os.environ.get("HERMES_HOME", "/root/.hermes")) / "skills/browser-harness/browser-profiles.json"
STATE = Path("/run/procvetaev-browser/selected-profile.json")
PROFILE_ROOT = Path("/var/lib/procvetaev-browser")
SERVICE_USER = "procvetaev-browser"
TARGET = "procvetaev-browser.target"
CDP_URL = "http://127.0.0.1:9222/json/version"
ID_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,47}")
ACTIVITY_LOCK = Path("/run/procvetaev-browser/activity.lock")


def fail(message: str) -> "NoReturn":
    raise RuntimeError(message)


def atomic_json(path: Path, data: dict, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp = Path(temp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        json.loads(temp.read_text(encoding="utf-8"))
        os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def normalize_registry(data: object) -> dict:
    if not isinstance(data, dict) or set(data) != {"default", "profiles"}:
        fail("Browser profile registry must contain only default and profiles")
    default = data.get("default")
    profiles = data.get("profiles")
    if not isinstance(default, str) or not isinstance(profiles, dict) or default not in profiles:
        fail("Browser profile registry default must identify an existing profile")
    normalized: dict[str, dict[str, str]] = {}
    root = PROFILE_ROOT.resolve()
    for profile_id, profile in profiles.items():
        if not isinstance(profile_id, str) or not ID_RE.fullmatch(profile_id):
            fail(f"Invalid Browser profile id: {profile_id!r}")
        if not isinstance(profile, dict) or set(profile) != {"label", "description", "user_data_dir"}:
            fail(f"Invalid Browser profile entry: {profile_id}")
        if not all(isinstance(profile[key], str) and profile[key].strip() for key in profile):
            fail(f"Browser profile fields must be non-empty strings: {profile_id}")
        path = Path(profile["user_data_dir"])
        if not path.is_absolute():
            fail(f"Browser profile path must be absolute: {profile_id}")
        resolved = path.resolve()
        if os.path.commonpath((str(root), str(resolved))) != str(root):
            fail(f"Browser profile path must be agent-owned under {PROFILE_ROOT}: {profile_id}")
        normalized[profile_id] = {
            "label": profile["label"].strip(),
            "description": profile["description"].strip(),
            "user_data_dir": str(resolved),
        }
    return {"default": default, "profiles": normalized}


def load_registry() -> dict:
    if not REGISTRY.is_file():
        fail(f"Browser profile registry is missing: {REGISTRY}")
    return normalize_registry(json.loads(REGISTRY.read_text(encoding="utf-8")))


def write_registry(data: dict) -> None:
    atomic_json(REGISTRY, normalize_registry(data))


def profile_dir(profile: dict[str, str]) -> Path:
    return Path(profile["user_data_dir"])


def ensure_profile_directory(profile: dict[str, str]) -> None:
    path = profile_dir(profile)
    path.mkdir(parents=True, exist_ok=True, mode=0o750)
    account = pwd.getpwnam(SERVICE_USER)
    os.chown(path, account.pw_uid, account.pw_gid)
    os.chmod(path, 0o750)


def process_profiles() -> list[dict[str, object]]:
    found = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            argv = [part.decode(errors="replace") for part in (proc / "cmdline").read_bytes().split(b"\0") if part]
        except OSError:
            continue
        if not any(part == "--remote-debugging-port=9222" for part in argv):
            continue
        user_data_dir = next((part.split("=", 1)[1] for part in argv if part.startswith("--user-data-dir=")), None)
        if user_data_dir:
            found.append({"pid": int(proc.name), "user_data_dir": str(Path(user_data_dir).resolve())})
    return sorted(found, key=lambda item: int(item["pid"]))


def cdp_ready() -> bool:
    try:
        with urllib.request.urlopen(CDP_URL, timeout=1) as response:
            return response.status == 200
    except Exception:
        return False


def systemctl(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["systemctl", *args],
        check=check,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )


def human_access_active() -> bool:
    return any(
        systemctl("is-active", "--quiet", unit, check=False).returncode == 0
        for unit in (
            "procvetaev-browser-share.service",
            "procvetaev-x11vnc.service",
            "procvetaev-novnc.service",
        )
    )


@contextmanager
def exclusive_activity():
    ACTIVITY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with ACTIVITY_LOCK.open("a+b") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def read_state(registry: dict) -> str | None:
    try:
        state = json.loads(STATE.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    profile_id = state.get("profile_id") if isinstance(state, dict) else None
    if profile_id not in registry["profiles"]:
        return None
    expected = registry["profiles"][profile_id]["user_data_dir"]
    return profile_id if state.get("user_data_dir") == expected else None


def write_state(profile_id: str, profile: dict[str, str]) -> None:
    atomic_json(STATE, {"profile_id": profile_id, "user_data_dir": profile["user_data_dir"]})


def prepare() -> str:
    registry = load_registry()
    selected = read_state(registry)
    active = process_profiles()
    if active or cdp_ready():
        fail("Port 9222 already has an owner before managed Chrome startup")
    selected = selected or registry["default"]
    profile = registry["profiles"][selected]
    ensure_profile_directory(profile)
    write_state(selected, profile)
    return selected


def terminate_daemons() -> None:
    subprocess.run(
        ["pkill", "-TERM", "-f", "[p]ython.*-m browser_harness.daemon"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def select(profile_id: str) -> dict:
    registry = load_registry()
    if profile_id not in registry["profiles"]:
        fail(f"Unknown Browser profile: {profile_id}")
    desired = registry["profiles"][profile_id]
    ensure_profile_directory(desired)
    active = process_profiles()
    if len(active) > 1:
        fail("More than one Chrome root owns the managed CDP contract")
    if active and active[0]["user_data_dir"] == desired["user_data_dir"] and cdp_ready():
        write_state(profile_id, desired)
        return {"profile_id": profile_id, "changed": False, "pid": active[0]["pid"]}
    with exclusive_activity():
        if human_access_active():
            fail("Cannot switch managed profile while Remote Access is active")
        active = process_profiles()
        if len(active) > 1:
            fail("More than one Chrome root owns the managed CDP contract")
        if active and active[0]["user_data_dir"] == desired["user_data_dir"] and cdp_ready():
            write_state(profile_id, desired)
            return {"profile_id": profile_id, "changed": False, "pid": active[0]["pid"]}
        target_active = systemctl("is-active", "--quiet", TARGET, check=False).returncode == 0
        if active or cdp_ready() or target_active:
            systemctl("stop", TARGET)
            deadline = time.monotonic() + 30
            while time.monotonic() < deadline and (process_profiles() or cdp_ready()):
                time.sleep(0.2)
            if process_profiles() or cdp_ready():
                fail("Previous managed Chrome did not release port 9222")
        terminate_daemons()
        write_state(profile_id, desired)
        systemctl("start", TARGET)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            active = process_profiles()
            if cdp_ready() and len(active) == 1 and active[0]["user_data_dir"] == desired["user_data_dir"]:
                return {"profile_id": profile_id, "changed": True, "pid": active[0]["pid"]}
            time.sleep(0.2)
    fail("Selected managed profile did not acquire port 9222")


def status() -> dict:
    registry = load_registry()
    active_processes = process_profiles()
    active_path = active_processes[0]["user_data_dir"] if len(active_processes) == 1 and cdp_ready() else None
    active_profile = next(
        (profile_id for profile_id, profile in registry["profiles"].items() if profile["user_data_dir"] == active_path),
        None,
    )
    return {
        "default": registry["default"],
        "active": active_profile,
        "active_user_data_dir": active_path,
        "profiles": registry["profiles"],
    }


def create_profile(profile_id: str, label: str, description: str) -> dict:
    if not ID_RE.fullmatch(profile_id):
        fail("Profile id must match [a-z0-9][a-z0-9-]{0,47}")
    registry = load_registry()
    if profile_id in registry["profiles"]:
        fail(f"Browser profile already exists: {profile_id}")
    profile = {
        "label": label.strip(),
        "description": description.strip(),
        "user_data_dir": str((PROFILE_ROOT / "profiles" / profile_id).resolve()),
    }
    if not profile["label"] or not profile["description"]:
        fail("Profile label and description must be non-empty")
    registry["profiles"][profile_id] = profile
    write_registry(registry)
    ensure_profile_directory(profile)
    return profile


def update_profile(profile_id: str, label: str | None, description: str | None) -> dict:
    registry = load_registry()
    if profile_id not in registry["profiles"]:
        fail(f"Unknown Browser profile: {profile_id}")
    profile = registry["profiles"][profile_id]
    if label is not None:
        profile["label"] = label.strip()
    if description is not None:
        profile["description"] = description.strip()
    write_registry(registry)
    return registry["profiles"][profile_id]


def set_default(profile_id: str) -> None:
    registry = load_registry()
    if profile_id not in registry["profiles"]:
        fail(f"Unknown Browser profile: {profile_id}")
    registry["default"] = profile_id
    write_registry(registry)
    subprocess.run(
        ["hermes", "config", "set", "--force", "browser.harness.user_data_dir", registry["profiles"][profile_id]["user_data_dir"]],
        check=True,
        stdout=subprocess.DEVNULL,
    )


def main() -> None:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    sub.add_parser("prepare")
    choose = sub.add_parser("select")
    choose.add_argument("profile_id")
    create = sub.add_parser("create")
    create.add_argument("profile_id")
    create.add_argument("--label", required=True)
    create.add_argument("--description", required=True)
    update = sub.add_parser("update")
    update.add_argument("profile_id")
    update.add_argument("--label")
    update.add_argument("--description")
    default = sub.add_parser("set-default")
    default.add_argument("profile_id")
    args = parser.parse_args()
    if os.geteuid() != 0:
        fail("browser-profile must run as root")
    if args.command == "status":
        result = status()
    elif args.command == "prepare":
        result = {"profile_id": prepare()}
    elif args.command == "select":
        result = select(args.profile_id)
    elif args.command == "create":
        result = create_profile(args.profile_id, args.label, args.description)
    elif args.command == "update":
        result = update_profile(args.profile_id, args.label, args.description)
    else:
        set_default(args.profile_id)
        result = {"default": args.profile_id}
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"browser-profile: {exc}", file=sys.stderr)
        raise SystemExit(1)
